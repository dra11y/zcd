#compdef zcd

autoload -U is-at-least

_zcd() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_zcd_commands" \
"*::: :->zcd" \
&& ret=0
    case $state in
    (zcd)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:zcd-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'-s+[The rank to increment the entry if it exists or initialize it with if it doesn'\''t]:SCORE:_default' \
'--score=[The rank to increment the entry if it exists or initialize it with if it doesn'\''t]:SCORE:_default' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::paths:_files -/' \
&& ret=0
;;
(complete)
_arguments "${_arguments_options[@]}" : \
'--limit=[Maximum number of completion candidates]:LIMIT:_default' \
'--current-dir=[Current working directory for filesystem completion]:CURRENT_DIR:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':partial -- Partial path to complete:_default' \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_zcd__edit_commands" \
"*::: :->edit" \
&& ret=0

    case $state in
    (edit)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:zcd-edit-command-$line[1]:"
        case $line[1] in
            (decrement)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':path:_default' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':path:_default' \
&& ret=0
;;
(increment)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':path:_default' \
&& ret=0
;;
(reload)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
        esac
    ;;
esac
;;
(import)
_arguments "${_arguments_options[@]}" : \
'--from=[Application to import from]:FROM:(autojump z)' \
'--merge[Merge into existing database]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':path:_files' \
&& ret=0
;;
(init)
_arguments "${_arguments_options[@]}" : \
'--cmd=[Changes the prefix of the \`z\` and \`zi\` commands]:CMD:_default' \
'--hook=[Changes how often zcd increments a directory'\''s score]:HOOK:(none prompt pwd)' \
'--no-cmd[Prevents zcd from defining the \`z\` and \`zi\` commands]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':shell:(bash elvish fish nushell posix powershell tcsh xonsh zsh)' \
&& ret=0
;;
(query)
_arguments "${_arguments_options[@]}" : \
'--exclude=[Exclude the current directory]:path:_files -/' \
'-a[Show unavailable directories]' \
'--all[Show unavailable directories]' \
'(-l --list)-i[Use interactive selection]' \
'(-l --list)--interactive[Use interactive selection]' \
'(-i --interactive)-l[List all matching directories]' \
'(-i --interactive)--list[List all matching directories]' \
'-s[Print score with results]' \
'--score[Print score with results]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::keywords:_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::paths:_files -/' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_zcd_commands] )) ||
_zcd_commands() {
    local commands; commands=(
'add:Add a new directory or increment its rank' \
'complete:Generate completion candidates for shell tab completion' \
'edit:Edit the database' \
'import:Import entries from another application' \
'init:Generate shell configuration' \
'query:Search for a directory in the database' \
'remove:Remove a directory from the database' \
    )
    _describe -t commands 'zcd commands' commands "$@"
}
(( $+functions[_zcd__add_commands] )) ||
_zcd__add_commands() {
    local commands; commands=()
    _describe -t commands 'zcd add commands' commands "$@"
}
(( $+functions[_zcd__complete_commands] )) ||
_zcd__complete_commands() {
    local commands; commands=()
    _describe -t commands 'zcd complete commands' commands "$@"
}
(( $+functions[_zcd__edit_commands] )) ||
_zcd__edit_commands() {
    local commands; commands=(
'decrement:' \
'delete:' \
'increment:' \
'reload:' \
    )
    _describe -t commands 'zcd edit commands' commands "$@"
}
(( $+functions[_zcd__edit__decrement_commands] )) ||
_zcd__edit__decrement_commands() {
    local commands; commands=()
    _describe -t commands 'zcd edit decrement commands' commands "$@"
}
(( $+functions[_zcd__edit__delete_commands] )) ||
_zcd__edit__delete_commands() {
    local commands; commands=()
    _describe -t commands 'zcd edit delete commands' commands "$@"
}
(( $+functions[_zcd__edit__increment_commands] )) ||
_zcd__edit__increment_commands() {
    local commands; commands=()
    _describe -t commands 'zcd edit increment commands' commands "$@"
}
(( $+functions[_zcd__edit__reload_commands] )) ||
_zcd__edit__reload_commands() {
    local commands; commands=()
    _describe -t commands 'zcd edit reload commands' commands "$@"
}
(( $+functions[_zcd__import_commands] )) ||
_zcd__import_commands() {
    local commands; commands=()
    _describe -t commands 'zcd import commands' commands "$@"
}
(( $+functions[_zcd__init_commands] )) ||
_zcd__init_commands() {
    local commands; commands=()
    _describe -t commands 'zcd init commands' commands "$@"
}
(( $+functions[_zcd__query_commands] )) ||
_zcd__query_commands() {
    local commands; commands=()
    _describe -t commands 'zcd query commands' commands "$@"
}
(( $+functions[_zcd__remove_commands] )) ||
_zcd__remove_commands() {
    local commands; commands=()
    _describe -t commands 'zcd remove commands' commands "$@"
}

if [ "$funcstack[1]" = "_zcd" ]; then
    _zcd "$@"
else
    compdef _zcd zcd
fi
